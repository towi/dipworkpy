@dwex
title: 18 — Pragma layout-fill
desc:  Eighteen nodes on a wide, flat strip (5 x 2 grid, aspect 2.5:1).
       Without the pragma the board letterboxes into a short, wide image.
       With layout-fill the coordinates are stretched anisotropically so
       the nodes fill the whole figure area; the relative layout (which
       field neighbours which) is preserved.

map {
  A01 L 0,0
  A02 L 1,0
  A03 L 2,0
  A04 L 3,0
  A05 L 4,0
  B01 L 0,1
  B02 L 1,1
  B03 L 2,1
  B04 L 3,1
  B05 L 4,1
  C01 O 0,2
  C02 O 1,2
  C03 O 2,2
  C04 O 3,2
  C05 O 4,2
  D01 L 0,3
  D02 L 1,3
  D03 L 2,3
  D04 L 3,3
  D05 L 4,3
  A01 -- A02
  A02 -- A03
  A03 -- A04
  A04 -- A05
  A01 -- B01
  A02 -- B02
  A03 -- B03
  A04 -- B04
  A05 -- B05
  B01 -- B02
  B02 -- B03
  B03 -- B04
  B04 -- B05
  B01 -- C01
  B02 -- C02
  B03 -- C03
  B04 -- C04
  B05 -- C05
  C01 -- C02
  C02 -- C03
  C03 -- C04
  C04 -- C05
  C01 -- D01
  C02 -- D02
  C03 -- D03
  C04 -- D04
  C05 -- D05
  D01 -- D02
  D02 -- D03
  D03 -- D04
  D04 -- D05
  A01 -- B02
  A05 -- B04
}

units {
  Au A A01
  Ge A A05
  En A B03
  Fr A D01
  It A D05
}

orders {
  Au A A01 mve B02
  Ge A A05 mve B04 !
  En A B03 mve C03
  Fr A D01 msup En
  It A D05 hld
}

pragmas {
  layout-fill
}
@end
