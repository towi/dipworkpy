@dwex
title: 18 — Pragma layout-fill
desc:  Twenty nodes with an intentionally UNEVEN source layout: ten are
       crammed into the left third, ten are spread over the rest. Without
       the pragma the left cluster renders dense and unreadable. With
       layout-fill the coordinates are first stretched, then a bounded
       Lloyd relaxation moves every node toward its Voronoi-cell centroid:
       the cluster spreads into the empty space while the neighborhood
       structure (who borders whom) is preserved.

map {
  A01 L 0,0
  A02 L 0.5,0.1
  A03 L 0.1,0.5
  A04 L 0.6,0.6
  A05 L 0.3,0.3
  A06 L 0.2,0.8
  A07 L 0.7,0.2
  A08 L 0.4,0.9
  A09 L 0.6,0.4
  A10 L 0.1,0.2
  B01 L 2,0.2
  B02 L 3,0.1
  B03 L 2.5,0.8
  B04 L 3.5,0.6
  B05 L 4,0.3
  C01 O 2,-0.5
  C02 O 3.2,-0.6
  C03 O 4.2,-0.4
  D01 L 2,1.4
  D02 L 3.4,1.5
  A01 -- A02
  A02 -- A05
  A05 -- A03
  A05 -- A09
  A03 -- A10
  A09 -- A04
  A04 -- A07
  A03 -- A06
  A06 -- A08
  A08 -- A09
  A02 -- A07
  A10 -- A02
  A01 -- A10
  A01 -- A06
  A05 -- A04
  A06 -- A09
  B01 -- B02
  B01 -- B03
  B02 -- B04
  B04 -- B05
  B03 -- B04
  C01 -- C02
  C02 -- C03
  B01 -- C01
  B02 -- C02
  B05 -- C03
  B03 -- D01
  B04 -- D02
  D01 -- D02
  A07 -- B01
  A04 -- B03
}

units {
  Au A A01
  Ge A A05
  En A B03
  Fr A D01
  It A C02
}

orders {
  Au A A01 mve A10
  Ge A A05 mve A09 !
  En A B03 mve B04
  Fr A D01 msup En
  It A C02 hld
}

pragmas {
  layout-fill
}
@end
